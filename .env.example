# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/southern_roots

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
SESSION_SECRET=change_me_to_64_random_hex_characters_before_deploying

# ─── Auth & Security ─────────────────────────────────────────────────────────
# Secret used to sign JWTs (falls back to SESSION_SECRET). Min 32 chars.
JWT_SECRET=change_me_to_64_random_hex_characters_before_deploying
# Set to "true" to require login on all admin/agent API routes.
# Keep "false" until the frontend login flow is wired up.
AUTH_ENABLED=false
# Comma-separated list of allowed browser origins. Leave blank for permissive dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── AI (REQUIRED for autonomy) ──────────────────────────────────────────────
# Powers every agent — quoting, vision lawn measurement, comms, upsell, churn.
OPENAI_API_KEY=sk-...
# ANTHROPIC not used — this build is OpenAI-only.

# ─── Google Maps (REQUIRED for real quoting) ─────────────────────────────────
# Enable: Geocoding API + Maps Static API. Lets the Quote agent measure lawns.
GOOGLE_MAPS_API_KEY=AIza...

# ─── Resend (REQUIRED — email is how the system talks to customers) ──────────
RESEND_API_KEY=re_...
# Sender address. In production use a verified domain. For testing, Resend's
# onboarding@resend.dev works (delivers to your own verified account email).
EMAIL_FROM=Southern Roots Turf <onboarding@resend.dev>

# ─── Twilio (SMS) — DISABLED. This build is email-first; SMS is a no-op. ──────
# (left here for reference only; no keys needed)

# ─── Stripe (Payments + Subscription Billing) ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price IDs for the SaaS plans (create these in your Stripe dashboard).
# Billing endpoints stay disabled until STRIPE_SECRET_KEY + these are set.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ─── Owner Contact ───────────────────────────────────────────────────────────
OWNER_PHONE_NUMBER=+1xxxxxxxxxx
OWNER_EMAIL=owner@southernrootsturf.com
