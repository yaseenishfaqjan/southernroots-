# Copy to .env on the VPS and fill in. (DATABASE_URL/REDIS_URL are injected by
# docker-compose.prod.yml — you do NOT need to set them here.)

NODE_ENV=production
PORT=3001

# Host port the web app listens on (default 8090 to avoid clashing with other
# projects on :80). Access at http://YOUR_IP:8090, or proxy your domain to it.
WEB_PORT=8090

# Your public URLs (used in emails: the "Accept quote" link, etc.)
APP_URL=https://app.yourdomain.com
PUBLIC_APP_URL=https://app.yourdomain.com

# Strong secret — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_random_hex_chars

# Browser origins allowed to call the API (your domain)
CORS_ORIGINS=https://app.yourdomain.com

# Database password (used by both postgres and the api connection string)
POSTGRES_PASSWORD=change_me_strong

# Your Docker Hub username (only needed for the docker-compose.hub.yml VPS deploy)
DOCKERHUB_USER=your_dockerhub_username

# ─── AI (required) ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_MAPS_API_KEY=AIza...

# ─── Email (required — Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Southern Roots Turf <quotes@scalaro.io>
OWNER_EMAIL=you@yourdomain.com

# ─── Stripe (add later to take payments) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
