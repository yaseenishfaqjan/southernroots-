{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx/esm ./src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "create-owner": "node --env-file=../../.env --import tsx/esm ./src/scripts/create-owner.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "@workspace/api-types": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@anthropic-ai/sdk": "catalog:",
    "bullmq": "catalog:",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "@googlemaps/google-maps-services-js": "catalog:",
    "ioredis": "catalog:",
    "jsonwebtoken": "catalog:",
    "bcryptjs": "catalog:",
    "node-cron": "catalog:",
    "openai": "catalog:",
    "pino": "^9",
    "pino-http": "^10",
    "puppeteer": "catalog:",
    "resend": "catalog:",
    "stripe": "catalog:",
    "twilio": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "catalog:",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "@types/node-cron": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
