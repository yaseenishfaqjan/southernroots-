# ── Build the static frontend ────────────────────────────────────────────────
FROM node:20-slim AS build
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
WORKDIR /app
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN node web-app/node_modules/vite/bin/vite.js build web-app

# ── Serve with nginx (also proxies /api -> api container) ────────────────────
FROM nginx:alpine
COPY --from=build /app/web-app/dist /usr/share/nginx/html
COPY web-app/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
